# ─── Database (Supabase PostgreSQL - IPv4 Pooler) ─────────────────────
# Transaction Pooler (Port 6543) - used by app runtime on Vercel
DATABASE_URL="postgresql://postgres.qgqfiahnojezcvxtkxbe:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session Pooler (Port 5432) - used for Prisma migrations and Vercel build
DIRECT_URL="postgresql://postgres.qgqfiahnojezcvxtkxbe:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ─── Auth.js ─────────────────────────────────────────────────────────
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── Cloudinary ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─── Nodemailer / SMTP Email Service ──────────────────────────────────
# For Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="465" (or 587), SMTP_SECURE="true"
# For custom SMTP (e.g. Hostinger, Zoho, SendGrid, Outlook): fill host & port
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-or-smtp-password"
SMTP_FROM="SP Solutions <your-email@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="spsolutions.cbe@gmail.com"

# ─── Site URL (For Social Sharing Preview) ────────────────────────────
NEXT_PUBLIC_SITE_URL="https://sp-solutions.vercel.app"


